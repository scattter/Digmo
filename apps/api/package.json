{
  "name": "@digmo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "user:create": "tsx src/cli.ts user:create",
    "data:export": "tsx src/cli.ts data:export",
    "data:import": "tsx src/cli.ts data:import",
    "demo:realtime-provider-poc": "tsx src/demo/realtime-provider-poc/run.ts"
  },
  "dependencies": {
    "@digmo/shared": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "fastify": "^5.2.1",
    "openai": "^6.31.0",
    "redis": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "pino-abstract-transport": "^3.0.0",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
