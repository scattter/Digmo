{
  "version": 2,
  "builds": [
    {
      "src": "vercel-handler.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/v1/(.*)",
      "dest": "/vercel-handler.ts"
    },
    {
      "src": "/v1",
      "dest": "/vercel-handler.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/vercel-handler.ts"
    }
  ]
}
